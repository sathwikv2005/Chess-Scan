{
	"name": "chess-scan",
	"version": "1.0.1",
	"description": "Convert chessboard images into FEN notation",
	"author": "sathwikv2005",
	"license": "MIT",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"model/board-detection.onnx",
		"model/chess-piece_3.onnx",
		"model/labels_3.json",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"dev": "tsx src/index.ts",
		"build": "tsc",
		"prepublishOnly": "npm run build",
		"clean": "rm -rf dist",
		"test": "vitest",
		"test:watch": "vitest --watch",
		"generate": "npx tsx training/generateDataset.ts",
		"split": "npx tsx training/splitDataset.ts"
	},
	"keywords": [
		"chess",
		"fen"
	],
	"dependencies": {
		"@resvg/resvg-js": "^2.6.2",
		"@techstark/opencv-js": "^4.12.0-release.1",
		"onnxruntime-node": "^1.26.0",
		"sharp": "^0.34.5"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sathwikv2005/chess-scan.git"
	},
	"bugs": {
		"url": "https://github.com/sathwikv2005/chess-scan/issues"
	},
	"homepage": "https://github.com/sathwikv2005/chess-scan#readme"
}
